{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // @seald-io/sdk only has node/browser/react-native export conditions.
    "customConditions": ["browser"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      // Seald's types import these paths without an extension, which
      // "bundler" resolution can't resolve (the types become `any`).
      "@seald-io/sdk/lib/main": ["./node_modules/@seald-io/sdk/lib/main.d.ts"],
      "@seald-io/sdk-plugin-ssks-password/lib/main": [
        "./node_modules/@seald-io/sdk-plugin-ssks-password/lib/main.d.ts"
      ]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
